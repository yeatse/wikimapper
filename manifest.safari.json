{
  "manifest_version": 3,

  "name": "WikiMapper",
  "description": "WikiMapper - Track and graph your adventures down the Wikipedia rabbit hole.",
  "version": "3.0.4",
  "icons": {
    "19": "assets/wikimapper-19.png",
    "38": "assets/wikimapper-38.png",
    "48": "assets/wikimapper-48.png",
    "128": "assets/wikimapper-128.png"
  },
  "author": "Patrick McCarthy",
  "homepage_url": "http://www.github.com/ptmccarthy/wikimapper",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "webNavigation",
    "storage",
    "nativeMessaging"
  ],

  "host_permissions": [
    "*://*.wikipedia.org/*",
    "*://*.wiktionary.org/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.wikipedia.org/*",
        "*://*.wiktionary.org/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_title": "WikiMapper",
    "default_icon": "assets/wikimapper-38.png"
  }
}